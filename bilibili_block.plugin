[Plugin]
name = Bilibili 精准去广告重写 (缓存刷新版)
desc = 拦截秒针第三方追踪，并通过 JS 脚本动态清空广告数据。
author = xiangjiaoxun
homepage = https://github.com/xiangjiaoxun/guanggao
version = 1.1.2

[Script]
# 末尾加了 ?v=1 用来强制刷新镜像缓存，防止 Loon 提示下载失败
http-response ^https?:\/\/cm\.bilibili\.com\/cm\/api\/(fees\/wise|conversion\/mobile\/v2) script-path=https://raw.githubusercontent.com/xiangjiaoxun/guanggao/refs/heads/main/bilibili.js%E2%81%A0, requires-body=true, timeout=10, tag=Bilibili广告重写

[Rule]
DOMAIN-SUFFIX, miaozhen.com, REJECT

[MITM]
hostname = cm.bilibili.com
