[Plugin]
name = Bilibili 精准去广告重写
desc = 拦截秒针第三方追踪，并通过 JS 脚本动态清空 cm.bilibili.com 的卡片广告与开屏广告缓存数据。
author = xiangjiaoxun
homepage = https://github.com/xiangjiaoxun/guanggao
version = 1.1.0

[Script]
# 拦截并重写 B 站核心广告分发接口
http-response ^https?:\/\/cm\.bilibili\.com\/cm\/api\/(fees\/wise|conversion\/mobile\/v2) script-path=https://raw.githubusercontent.com/xiangjiaoxun/guanggao/main/bilibili.js, requires-body=true, timeout=10, tag=Bilibili广告重写

[Rule]
# 拦截秒针等第三方广告追踪埋点
DOMAIN-SUFFIX, miaozhen.com, REJECT

[MITM]
hostname = cm.bilibili.com
